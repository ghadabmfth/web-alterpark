# --- Serveur uniquement (jamais préfixées NEXT_PUBLIC_) ---
# URL racine de l'API REST WordPress, sans slash final
WP_API_URL=http://localhost:8888/wp-json
# Secret partagé avec le plugin (constante APBS_API_SECRET dans wp-config.php), 32 caractères minimum
APBS_API_SECRET=dev-api-secret-change-me-at-least-32-chars
# Secret des webhooks de revalidation envoyés par WordPress (ALTERPARK_REVALIDATE_SECRET), 32 caractères minimum
REVALIDATE_SECRET=dev-revalidate-secret-change-me-32chars

# --- Public (exposé au navigateur par conception) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Clé publiable Stripe (pk_test_… / pk_live_…). La clé secrète reste dans WordPress.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
