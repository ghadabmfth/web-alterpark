# ALTERPARK — environment variables
# Copy to .env.local for development. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are sent to the browser BY DESIGN: never put a secret in them.
# On Vercel, define each variable per environment (Development / Preview / Production);
# Preview must use test keys and a separate database.
# "Phase" = the roadmap phase that starts reading the variable (docs/ROADMAP.md).

# ── Site (Phase 1) ─────────────────────────────────────────────
# Canonical public URL, no trailing slash. Used for metadata, sitemap, e-mail links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (Phase 4) ─────────────────────────────────────────
# Pooled connection used by the application at runtime (Neon: the "-pooler" host).
# Needed at BUILD time too on Vercel: migrations run before `next build` (scripts/migrate-on-deploy.mjs).
DATABASE_URL=postgresql://alterpark:alterpark@localhost:5432/alterpark
# Direct (non-pooled) connection used by `prisma migrate`. Optional: falls back to DATABASE_URL.
DIRECT_DATABASE_URL=
# Integration tests only (`npm run test:integration`); the database name MUST end in _test.
TEST_DATABASE_URL=postgresql://alterpark:alterpark@localhost:5432/alterpark_test

# First super administrator, created by the seed if it does not exist yet. Set it for ONE
# deployment, sign in, change the password, then remove both variables.
# Local demo data only (npm run db:demo, refuses non-local databases): adds one confirmed demo
# reservation for this existing account.
# DEMO_CUSTOMER_EMAIL=
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

# ── Authentication — Auth.js (Phase 4) ─────────────────────────
# 32+ random characters: `openssl rand -base64 32`. Different value per environment.
# Changing it signs everybody out.
AUTH_SECRET=
# Only needed outside Vercel or behind a proxy.
# AUTH_URL=http://localhost:3000

# ── Payments — Stripe (Phase 6) ────────────────────────────────
# Use test keys everywhere except Production. A restricted key (rk_) with write access to
# Checkout Sessions and Refunds only is recommended.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (/api/webhooks/stripe). Locally: `stripe listen
# --forward-to localhost:3000/api/webhooks/stripe` prints it. Payment stays disabled in the
# booking funnel until both variables are set. (The hosted Checkout page needs no publishable key.)
STRIPE_WEBHOOK_SECRET=

# ── E-mail notifications (Phase 4) ─────────────────────────────
# console = print e-mails to the server log (development); resend = send through Resend.
EMAIL_TRANSPORT=console
RESEND_API_KEY=
EMAIL_FROM="ALTERPARK <reservation@example.com>"
# Receives new contact messages and payment incidents.
ADMIN_NOTIFICATION_EMAIL=ops@example.com

# ── Security (Phase 4) ─────────────────────────────────────────
# Salt for hashing IP addresses (rate limiting, abuse handling) without storing them. 32+ chars.
IP_HASH_SALT=
# Bearer secret Vercel Cron sends to /api/cron/* (e-mail retries, clean-up). 32+ chars.
CRON_SECRET=

# ── Anti-spam — Cloudflare Turnstile (Phase 7, optional) ───────
# Without these, the contact form relies on honeypot + rate limiting only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Development tools ─────────────────────────────────────────
# Exposes the design-system gallery (/dev/design-system) in a production build, e.g. on a Preview
# deployment for client review. Never "true" in Production.
DESIGN_SYSTEM_GALLERY=false

# ── Search engines ────────────────────────────────────────────
# "true" only on Production at launch: enables indexing (robots.txt, meta robots).
# Preview and development must stay unindexed.
SITE_INDEXABLE=false

# ── Monitoring (Phase 8) ───────────────────────────────────────
# Server and browser errors are written to the logs as one JSON line ("event":"alterpark.error").
# Optional: also POST each report to this URL (Slack incoming webhook, Better Stack, Sentry HTTP…).
ERROR_WEBHOOK_URL=
