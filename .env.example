# ALTERPARK — environment variables
# Copy to .env.local for development. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are sent to the browser BY DESIGN: never put a secret in them.
# On Vercel, define each variable per environment (Development / Preview / Production);
# Preview must use test keys and a separate database.
# "Phase" = the roadmap phase that starts reading the variable (docs/ROADMAP.md).

# ── Site (Phase 1) ─────────────────────────────────────────────
# Canonical public URL, no trailing slash. Used for metadata, sitemap, e-mail links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (Phase 4) ─────────────────────────────────────────
# Pooled connection used by the application at runtime.
DATABASE_URL=postgresql://alterpark:alterpark@localhost:5432/alterpark?schema=public
# Direct (non-pooled) connection used by `prisma migrate`. Optional: falls back to DATABASE_URL.
DIRECT_DATABASE_URL=

# ── Authentication — Auth.js (Phase 4) ─────────────────────────
# 32+ random characters: `openssl rand -base64 32`. Different value per environment.
AUTH_SECRET=
# Only needed outside Vercel or behind a proxy.
# AUTH_URL=http://localhost:3000

# ── Payments — Stripe (Phase 6) ────────────────────────────────
# Use test keys everywhere except Production. A restricted key (rk_) limited to
# Checkout Sessions, PaymentIntents and Refunds is recommended.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (/api/webhooks/stripe). Locally: `stripe listen`.
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── E-mail notifications (Phase 5) ─────────────────────────────
# console = print e-mails to the server log (development); resend = send through Resend.
EMAIL_TRANSPORT=console
RESEND_API_KEY=
EMAIL_FROM="ALTERPARK <reservation@example.com>"
# Receives new contact messages and payment incidents.
ADMIN_NOTIFICATION_EMAIL=ops@example.com

# ── Security (Phase 4) ─────────────────────────────────────────
# Salt for hashing IP addresses (rate limiting, abuse handling) without storing them. 32+ chars.
IP_HASH_SALT=
# Bearer secret Vercel Cron sends to scheduled jobs (hold expiry, e-mail outbox). 32+ chars.
CRON_SECRET=

# ── Anti-spam — Cloudflare Turnstile (Phase 7, optional) ───────
# Without these, the contact form relies on honeypot + rate limiting only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Development tools ─────────────────────────────────────────
# Exposes the design-system gallery (/dev/design-system) in a production build, e.g. on a Preview
# deployment for client review. Never "true" in Production.
DESIGN_SYSTEM_GALLERY=false
