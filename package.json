{
  "name": "web-alterpark",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "npm run dev -w @alterpark/web",
    "build": "npm run build -w @alterpark/web",
    "lint": "npm run lint -w @alterpark/web",
    "typecheck": "npm run typecheck -w @alterpark/web",
    "test": "npm run test -w @alterpark/web",
    "wp:start": "wp-env start",
    "wp:stop": "wp-env stop",
    "plugin:zip": "bash wordpress/plugins/alterpark-booking/bin/build-zip.sh",
    "wordpress:package": "bash wordpress/bin/build-site.sh"
  },
  "devDependencies": {
    "@wordpress/env": "12.0.0"
  },
  "packageManager": "npm@11.6.2"
}
