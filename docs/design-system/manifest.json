  "components": [
    {
      "name": "Button",
      "group": "Actions",
      "summary": "Bouton d'action en pilule, orange par défaut, pour l'action principale d'une section (réserver, découvrir, en savoir plus)."
    },
    {
      "name": "IconButton",
      "group": "Actions",
      "summary": "Bouton sans libellé visible : flèches du carrousel et bouton de lecture vidéo."
    },
    {
      "name": "Header",
      "group": "Navigation",
      "summary": "En-tête du site : filet orange de 10 px, navigation en deux moitiés autour du logo centré ; burger et panneau en mobile."
    },
    {
      "name": "Breadcrumbs",
      "group": "Navigation",
      "summary": "Fil d'Ariane des pages intérieures."
    },
    {
      "name": "SocialRail",
      "group": "Navigation",
      "summary": "Rail d'onglets fixé au bord droit : Facebook, espace client, YouTube."
    },
    {
      "name": "Footer",
      "group": "Navigation",
      "summary": "Pied de page : logo, droits, mentions légales, adresse, contact, filet orange de 10 px."
    },
    {
      "name": "Hero",
      "group": "Patterns",
      "summary": "Ouverture de l'accueil : photo plein cadre voilée, H1 en Crossroads, introduction, étapes et bouton."
    },
    {
      "name": "SectionHeading",
      "group": "Contenu",
      "summary": "Titre de section en Crossroads blanc, chiffres et ponctuation en orange, avec sous-titre et paragraphe facultatifs."
    },
    {
      "name": "Steps",
      "group": "Contenu",
      "summary": "Suite d'étapes numérotées : pictogramme orange, grand chiffre fantôme, titre en Crossroads, légende, filets pointillés."
    },
    {
      "name": "MediaSection",
      "group": "Patterns",
      "summary": "Section deux colonnes : titre, texte et bouton d'un côté, visuel de l'autre."
    },
    {
      "name": "Banner",
      "group": "Patterns",
      "summary": "Bandeau photo pleine largeur fondu dans le fond, suivi d'un contenu centré (logo partenaire, titre, texte, bouton)."
    },
    {
      "name": "RatingBadge",
      "group": "Contenu",
      "summary": "Badge de note Google en forme de bulle : pilule blanche avec une queue en bas à gauche, logo dans un cercle, note (« 4,4/5 »), étoiles remplies au dixième près…"
    },
    {
      "name": "Stars",
      "group": "Contenu",
      "summary": "Étoiles de notation jaunes accent."
    },
    {
      "name": "ReviewCard",
      "group": "Contenu",
      "summary": "Carte d'avis client : guillemet orange, étoiles, extrait sur 5 lignes, puis auteur (avatar, nom, date) et logo de la source."
    },
    {
      "name": "ReviewCarousel",
      "group": "Contenu",
      "summary": "Carrousel d'avis : défilement tactile avec accrochage, flèches rondes, points de pagination et défilement automatique."
    },
    {
      "name": "StoreBadges",
      "group": "Contenu",
      "summary": "Badges officiels Google Play et App Store."
    },
    {
      "name": "Accordion",
      "group": "Contenu",
      "summary": "Liste de questions dépliables, séparées par le filet pointillé de la marque."
    },
    {
      "name": "TextField",
      "group": "Formulaires",
      "summary": "Champ de saisie avec libellé, aide et message : texte, e-mail, mot de passe, téléphone, zone de texte."
    },
    {
      "name": "Select",
      "group": "Formulaires",
      "summary": "Liste déroulante native stylée."
    },
    {
      "name": "Checkbox",
      "group": "Formulaires",
      "summary": "Case à cocher."
    },
    {
      "name": "RadioGroup",
      "group": "Formulaires",
      "summary": "Choix unique dans un fieldset."
    },
    {
      "name": "Toggle",
      "group": "Formulaires",
      "summary": "Interrupteur pour un réglage activé immédiatement."
    },
    {
      "name": "Alert",
      "group": "Feedback",
      "summary": "Message de retour : succès, information, avertissement, erreur."
    },
    {
      "name": "Modal",
      "group": "Feedback",
      "summary": "Fenêtre de dialogue au-dessus d'un voile."
    },
    {
      "name": "AppShowcase",
      "group": "Patterns",
      "summary": "Visuel animé de l'application mobile de réservation ALTERPARK : deux téléphones dessinés en HTML/CSS/SVG, sans image."
    },
    {
      "name": "FeatureList",
      "group": "Contenu",
      "summary": "Liste d'atouts : pictogramme orange dans un carré teinté, titre en gras, texte de 16 px, sur une carte surface-raised."
    },
    {
      "name": "BookingBar",
      "group": "Patterns",
      "summary": "Barre de réservation orange : choix du parking par un interrupteur à deux positions (ALTERPARK ou ALTERECO, avec prix « dès »), départ et retour (date et heure…"
    },
    {
      "name": "VideoModal",
      "group": "Feedback",
      "summary": "Fenêtre plein écran qui lit une vidéo YouTube : voile sombre flouté, titre en Crossroads, bouton fermer rond, lecteur 16:9 aux coins arrondis."
    },
    {
      "name": "ServiceCard"
    },
    {
      "name": "Highlights"
    }
  ],
