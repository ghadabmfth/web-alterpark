{
  "name": "alterpark/booking-system",
  "description": "Plugin WordPress Alterpark Booking System",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "stripe/stripe-php": "^19.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^3.0",
    "wp-coding-standards/wpcs": "^3.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "autoload": {
    "psr-4": { "Alterpark\\Booking\\": "src/" }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true }
  },
  "scripts": {
    "lint": "phpcs --standard=WordPress --extensions=php src alterpark-booking.php uninstall.php",
    "test": "phpunit"
  }
}
